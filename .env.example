# TMDB API Configuration
# Get your API key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Backend Port (Port 3000'de başka uygulama varsa 3001 veya başka port kullan)
PORT=3001

# Database
DATABASE_URL=./data/metadata.db

# Environment
NODE_ENV=development

# Stream proxy: upstreams on private/loopback addresses are refused by default
# (this is what keeps the proxy from reaching the router or other LAN hosts).
# Set to true only when the IPTV provider runs on this same network.
ALLOW_PRIVATE_UPSTREAM=false

# Sessions (sign-in). Only token hashes are written to this file.
SESSIONS_PATH=./data/sessions.json
SESSION_IDLE_DAYS=30
SESSION_MAX_DAYS=90
# Mark the session cookie Secure — only when HTTPS terminates in front.
COOKIE_SECURE=false

# The /admin console. Its password is chosen on the first visit to /admin and
# stored scrypt-hashed here; there is no password in this file.
ADMIN_PATH=./data/admin.json
ADMIN_SESSION_IDLE_HOURS=12
ADMIN_SESSION_MAX_DAYS=7

# Start TMDB enrichment and the per-film audio probe as soon as the server comes
# up. Convenient on a desktop; set false on a small host (see PI_DEPLOY.md) and
# trigger the sync from /admin instead.
AUTO_ENRICH_ON_BOOT=true
